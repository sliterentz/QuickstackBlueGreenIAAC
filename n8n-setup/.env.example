# Basic Environment Setup
DOMAIN_NAME=example.com
SUBDOMAIN=n8n

# Database Configuration
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=secure_password_please_change

# n8n Security
# Generate a random string for this key
N8N_ENCRYPTION_KEY=super_secret_encryption_key_change_me
# Timezone
GENERIC_TIMEZONE=Asia/Jakarta

# Integration Credentials (will be used inside n8n UI, but good to have ready)
OPENAI_API_KEY=sk-...
WHATSAPP_ACCESS_TOKEN=...
WHATSAPP_PHONE_NUMBER_ID=...
WHATSAPP_BUSINESS_ACCOUNT_ID=...
